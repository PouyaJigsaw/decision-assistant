# Copy to apps/api/.env and fill in secrets. Never commit .env.
# On Fly.io, set the same names: fly secrets set TYPESAFE_API_KEY=...

ACCOUNT_EMAIL=recruiter@example.com
ACCOUNT_PASSWORD=sitting-password
DATABASE_PATH=data/decision-assistant.db
HOST=127.0.0.1
PORT=8787
PROVIDERS=live
EVALUATIONS_ENABLED=true
TRIAL_SUCCESS_CAP=infinite
DAILY_SPEND_CAP_USD=5

TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_INPUT_USD_PER_MILLION=0.042
JEV_OUTPUT_USD_PER_MILLION=0
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_INPUT_USD_PER_MILLION=5
LLM_OUTPUT_USD_PER_MILLION=25
